diff --git a/Sources/LocalLLMClientLlama/Context.swift b/Sources/LocalLLMClientLlama/Context.swift
index 7563929..7560837 100644
--- a/Sources/LocalLLMClientLlama/Context.swift
+++ b/Sources/LocalLLMClientLlama/Context.swift
@@ -49,6 +49,9 @@ public final class Context: @unchecked Sendable {
         ctx_params.n_ctx = UInt32(parameter.context)
         ctx_params.n_threads = Int32(parameter.numberOfThreads ?? Self.defaultNumberOfThreads)
         ctx_params.n_threads_batch = ctx_params.n_threads
+        ctx_params.flash_attn_type = parameter.flashAttention.llamaValue
+        ctx_params.type_k = parameter.kvCacheType.ggmlValue
+        ctx_params.type_v = parameter.kvCacheType.ggmlValue
 
         self.parameter = parameter
         self.pauseHandler = PauseHandler(disableAutoPause: parameter.options.disableAutoPause)
@@ -234,8 +237,37 @@ public extension Context {
         promptCaches = metadata.entries.map { (chunk: .text($0.text), lastPosition: $0.lastPosition) }
     }
 
+    /// Bytes llama.cpp needs to serialise this context's state — dominated by the KV cache, and
+    /// therefore how large a ``saveState(to:)`` file will be. Also the honest way to see what
+    /// ``LlamaClient/Parameter/kvCacheType`` actually bought you.
+    var stateSizeBytes: Int {
+        Int(llama_state_get_size(context))
+    }
+
     /// Companion file holding the prompt-cache bookkeeping for a state file.
     static func metadataURL(for stateURL: URL) -> URL {
         stateURL.appendingPathExtension("meta")
     }
 }
+
+// MARK: - Parameter bridging
+
+extension LlamaClient.FlashAttention {
+    var llamaValue: llama_flash_attn_type {
+        switch self {
+        case .auto:     LLAMA_FLASH_ATTN_TYPE_AUTO
+        case .enabled:  LLAMA_FLASH_ATTN_TYPE_ENABLED
+        case .disabled: LLAMA_FLASH_ATTN_TYPE_DISABLED
+        }
+    }
+}
+
+extension LlamaClient.KVCacheType {
+    var ggmlValue: ggml_type {
+        switch self {
+        case .f16:  GGML_TYPE_F16
+        case .q8_0: GGML_TYPE_Q8_0
+        case .q4_0: GGML_TYPE_Q4_0
+        }
+    }
+}
