+    /// When to enable Flash Attention.
+    ///
+    /// Flash Attention speeds up prefill at longer contexts and shrinks the per-token attention
+    /// footprint. It is also a **prerequisite for a quantized KV cache**: without it llama.cpp has
+    /// to dequantize the cache on every attention step, which can end up slower than not
+    /// quantizing at all.
+    enum FlashAttention: Sendable, Equatable {
+        /// Let llama.cpp decide (its own default).
+        case auto
+        case enabled
+        case disabled
+    }
+
+    /// Element type for the K/V cache.
+    ///
+    /// The KV cache grows with context length and is often the binding memory constraint on
+    /// memory-limited devices; quantizing it trades a little quality for a lot of headroom.
+    ///
+    /// - Important: use these only together with ``FlashAttention/enabled`` (or `.auto` on a build
+    ///   that turns it on). Quantizing without Flash Attention forces a dequantize on every
+    ///   attention computation and can be *slower* than ``f16``.
+    enum KVCacheType: Sendable, Equatable {
+        /// 16-bit — llama.cpp's default, no quality loss.
+        case f16
+        /// 8-bit — roughly half the KV memory, minimal quality impact.
+        case q8_0
+        /// 4-bit — roughly a quarter of the KV memory, noticeable quality impact.
+        case q4_0
+    }
+
     /// Specifies the desired format for the model's response.
     enum ResponseFormat: Sendable {
         /// Constrains the model's output to a specific grammar defined in GBNF (GGML BNF) format.
diff --git a/Tests/LocalLLMClientLlamaTests/ContextTuningTests.swift b/Tests/LocalLLMClientLlamaTests/ContextTuningTests.swift
new file mode 100644
index 0000000..0e488bc
--- /dev/null
+++ b/Tests/LocalLLMClientLlamaTests/ContextTuningTests.swift
@@ -0,0 +1,45 @@
+import Testing
+import Foundation
+import LocalLLMClientCore
+@testable import LocalLLMClientLlama
+
+extension ModelTests {
+    struct ContextTuningTests {}
+}
+
+extension ModelTests.ContextTuningTests {
+
+    /// The point of exposing `kvCacheType`: on memory-limited devices the KV cache is usually the
+    /// binding constraint, and quantizing it has to actually shrink it — not just change a flag.
+    @Test
+    func quantizedKVCacheIsSmallerThanF16() async throws {
+        let contextLength = 2048
+
+        // The state only covers the USED part of the cache, so it must be filled first — an empty
+        // context serialises to a bare header (~26 B) whatever the element type is.
+        let prompt = String(repeating: "The quick brown fox jumps over the lazy dog. ", count: 20)
+
+        let f16 = try await LocalLLMClient.llama(
+            parameter: .init(context: contextLength, flashAttention: .enabled, kvCacheType: .f16))
+        try f16._context.decode(text: prompt)
+        let f16Size = f16._context.stateSizeBytes
+
+        let q8 = try await LocalLLMClient.llama(
+            parameter: .init(context: contextLength, flashAttention: .enabled, kvCacheType: .q8_0))
+        try q8._context.decode(text: prompt)
+        let q8Size = q8._context.stateSizeBytes
+
+        #expect(f16._context.position == q8._context.position, "same prompt → same token count")
+        #expect(f16Size > 1024, "a filled f16 cache must be more than a header")
+        #expect(q8Size < f16Size,
+                "q8_0 KV cache (\(q8Size) B) must be smaller than f16 (\(f16Size) B)")
+    }
+
+    /// Defaults must reproduce llama.cpp's own, so existing callers see no behaviour change.
+    @Test
+    func defaultsAreUnquantifiedAndAutoFlashAttention() {
+        let parameter = LlamaClient.Parameter()
+        #expect(parameter.kvCacheType == .f16)
+        #expect(parameter.flashAttention == .auto)
+    }
+}
